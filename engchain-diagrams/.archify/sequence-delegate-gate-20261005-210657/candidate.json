  "cards": [
    {
      "dot": "emerald",
      "title": "执行逻辑要点（真实代码）",
      "items": [
        "gateRealname()：realnameOk() 为真即 onPass 放行；否则 showRealnameGuide() 拦截",
        "三模板 FORM_TEMPLATES：franchise / trade / general；personnel 无独立模板，回退 general",
        "upsert()：prev 状态为「已承接」时 rec.status 强制保留，不被普通提交覆盖",
        "提交成功写 engchain_delegates；旧 franchise_delegate_v1 按 id 去重迁移后清除",
        "委托编号 = W + 时间戳后 8 位（add() 内生成）"
      ]
    },
    {
      "dot": "amber",
      "title": "校验分支（collectForm）",
      "items": [
        "需求类型 chip 未选 → toast「请选择…」并 return null，阻断提交",
        "地区 parseRegion 未 ok → toast 提示正确省/市（如：四川省 成都）",
        "锁定态联系人/电话只读取自实名认证；手机号须匹配 ^1[3-9]\\d{9}$",
        "编辑页 authLocked:false 可改联系信息；新增页默认锁定只读"
      ]
    },
    {
      "dot": "rose",
      "title": "口径边界",
      "items": [
        "纯前端 localStorage 模拟，无真实后端；[模拟] 接口为规划占位",
        "联系人 / 电话 v2.0 锁定只读，仅可补充备用手机号",
        "事实来源 js/delegates.js、pages/profile/delegate-new|delegate-edit.html；docs/ 不挂 sources"
      ]
    }
  ]
