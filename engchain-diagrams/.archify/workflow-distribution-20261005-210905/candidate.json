  "cards": [
    {
      "dot": "cyan",
      "title": "机制要点 · 合规两级",
      "items": [
        "层级硬上限 maxLevel=2：一级=直接邀请，二级=伙伴再邀请，超两级不参与返佣（js/domain.js:296-312）",
        "费率分档：建筑/合伙人企业 L1 12% / L2 3%；中介企业 L1 6% / L2 不开放；个人合伙人 L1 8% / L2 2%",
        "返佣单 RB：status frozen → settled → paid；frozenUntil = 创建 + freezeDays(默认 1 天)",
        "受益人须为有效分销员（入驻企业或个人合伙人），幂等校验防重复计佣"
      ]
    },
    {
      "dot": "amber",
      "title": "提现与结算口径（演示参数）",
      "items": [
        "起提门槛：企业档满 ¥100 / 个人合伙人满 ¥50；单笔 ≤¥1000、每日 ≤2 次",
        "手续费 ¥0，审批后 2 小时内到账；到账方式银行卡（规则页另列支付宝）",
        "状态机：pending 待审核 → first_ok 初审通过 → paid 已到账 / rejected 驳回 / cancelled 撤销",
        "工作日 T+1 结算；返佣计入钱包 totalRebate，不污染累计充值 totalIn"
      ]
    },
    {
      "dot": "rose",
      "title": "追回与违规处罚",
      "items": [
        "伙伴退款：对应返佣追回——已冻结直接取消；已结算从后续佣金中等额抵扣",
        "违规四类：自买自刷/虚假交易/恶意注册套佣；批量注册与机器模拟；群发骚扰；返利承诺诱导",
        "处罚阶梯：佣金全部追回 + 警告 / 冻结提现 / 封禁账号直至清退，并保留法律追责权利",
        "全部为纯前端高保真原型（PHASE0 信息撮合阶段，平台暂不抽佣）"
      ]
    }
  ]
