pages/guide/verify.js

# Node / 构建工具 / 开发脚本目录
node_modules/
tools/
docs/

# 开发调试 / 测试脚本（非运行时）
_tmp_server.js
debug-*.js
deep-test*.js
test-runner.js
verify-*.js
verify-milestone-fix.js

# 备份文件
*.bak*

# 杂项开发产物
*.py

# 内部业务 / 分析文档（不对外公开）
