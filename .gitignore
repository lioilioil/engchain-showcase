/CRM/

# 招标需求书 / 报价表（含商业报价）
# 2026-09-30 从公开仓库移出，归档至 D:\Engchain3.0-archive\招标文件-*\；
# demo 只把“招标文件”当商品名字符串用，没有任何路径引用。
# 要重新纳入版本控制，删掉下面这行即可。
/招标文件/

# 操作系统杂项
Thumbs.db
.DS_Store

# ─────────────────────────────────────────────
# 2026-09-30 根目录清理：以下内容已移入
#   D:\Engchain3.0-archive\（含 _MANIFEST.json 迁移清单）。
# 加规则防止再次被提交；如需恢复，从归档目录取回并在此放行。
# ─────────────────────────────────────────────

# 设计/审计运行产物（截图、报告、方案稿）
/ui-design-runs/
/.verify-shots/
/verify-om-v*/
/scripts-phase0/
/draft_*_folder/
/doc-fetch-resources/
/.preview/
/.tmp_backup_*/
/admin-v2/

# artifacts/：只放行“在线生成链路的上游源码”（swipe-nav、
# tabbar-redesign）。其余审计报告 md/html、e2e 截图、一次性样片一律不进仓库。
#   注意顺序：先排 artifacts/ 整层，再放行两个真源码目录，
#   最后用 _*/ 规则排掉 tabbar-redesign 内部的输出目录（_shots/_look/_probe…）。
/artifacts/*
!/artifacts/swipe-nav/
!/artifacts/tabbar-redesign/
#   tabbar-redesign 根层只保留 lg/（改版期的 *.png / `_user_upload2.bin` /
#   方案稿 html 都是 2026-09-17 的草稿，已归档）
/artifacts/tabbar-redesign/*
!/artifacts/tabbar-redesign/lg/
#   lg/ 内部的 _* 目录（_shots/_look/_probe/_metrics…）仍是运行产物
/artifacts/**/_*/

# 时间戳备份副本（*.bak* 已在上面覆盖；下面补 .backup- / .bak-orig）
*.backup-*
*.bak-orig

# 注：artifacts/tabbar-redesign/lg/ 与 artifacts/swipe-nav/ 里的 *.py 是
# css/liquid-dock.css、js/swipe-nav.js 的上游生成脚本（sync.py、apply-demo.py…），
# 沿用手册里既有的 `*.py` 全局忽略，不进公开仓库；文件保留在工作区，
# 重建链路照常可跑。若希望纳入版本控制，在此加：
#   !artifacts/tabbar-redesign/lg/*.py
#   !artifacts/swipe-nav/*.py
